#!/bin/bash
# agent-notify - Notification handler for Claude Code hooks

# Hooks inherit Claude's PATH, but --recv runs as an ssh forced command, which
# gets a bare one — no ~/bin (slack-noti) and no Homebrew (jq, tmux).
export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Enable/disable Slack notifications (defaults to true)
# AGENT_NOTIFY_SLACK=false        - never send Slack notifications
# AGENT_NOTIFY_SLACK_AWAY_ONLY=true - only send when away: display asleep, or
#                                    someone driving this Mac over VNC
#                                    (both travel with a forwarded notification,
#                                     so set them on the machine Claude runs on)
# AGENT_NOTIFY_SLACK_WHEN_WATCHED=true - Slack even when a tmux client with
#                                    terminal focus is showing the pane (an iPad
#                                    on Blink counts). Off by default; travels too.
# AGENT_NOTIFY_HOST=gfe            - prefix the session label (e.g. "gfe:hd-recovery")
#                                    to distinguish this machine from others sharing the
#                                    same #notifications channel. Unset = no prefix.
# AGENT_NOTIFY_FORWARD=e14,e14-wifi - this machine has no GUI worth notifying (a box you
#                                    only ever ssh into), so hand the notification to the
#                                    machine you are sitting at and let its agent-notify
#                                    --recv draw it. Comma-separated addresses for the
#                                    same host are tried in order, since DHCP decides
#                                    which one answers today.
#
# --recv                            - read one of those forwarded payloads on stdin instead
#                                    of a hook payload. Wired up as a forced command in
#                                    ~/.ssh/authorized_keys so the sending box's key can do
#                                    this and nothing else.
AGENT_NOTIFY_SLACK="${AGENT_NOTIFY_SLACK:-true}"
# Slack is the away channel: a banner is for when you are here, Slack is for when
# you are not. SLEEP_ONLY is the old name from when a dark display was the only
# thing we knew how to measure; it still works.
AGENT_NOTIFY_SLACK_AWAY_ONLY="${AGENT_NOTIFY_SLACK_AWAY_ONLY:-${AGENT_NOTIFY_SLACK_SLEEP_ONLY:-false}}"
# A dark display is not the only way to be reading this pane from somewhere the
# banner cannot reach: an iPad on the couch, attached over ssh through Blink, is
# a screen with the reply already on it. tmux can see that (see
# pane_watched_in_tmux), so Slack stays quiet for it unless this says otherwise.
AGENT_NOTIFY_SLACK_WHEN_WATCHED="${AGENT_NOTIFY_SLACK_WHEN_WATCHED:-false}"
# AGENT_NOTIFY_PERMISSION=true - banner the Notification event too: a permission
#                                 or approval prompt. Off by default. Running with
#                                 auto-approval makes one rare, and the one that does
#                                 fire is the generic "Claude needs your permission"
#                                 that trails an AskUserQuestion - same group, so it
#                                 replaces the banner naming the actual question with
#                                 one saying less.
AGENT_NOTIFY_PERMISSION="${AGENT_NOTIFY_PERMISSION:-false}"
# AGENT_NOTIFY_WHEN_VISIBLE=true - banner a pane you are already watching. Off by
#                                 default: if the terminal is frontmost, showing the
#                                 tab this pane's tmux window lives in, and the pane
#                                 is the active one there, the notification is telling
#                                 you what is already on your screen. Same for a pane
#                                 a tmux client with terminal focus is showing, which
#                                 covers a screen that is not this one.
AGENT_NOTIFY_WHEN_VISIBLE="${AGENT_NOTIFY_WHEN_VISIBLE:-false}"
# Terminal app to raise when a desktop notification is clicked
AGENT_NOTIFY_TERMINAL="${AGENT_NOTIFY_TERMINAL:-Ghostty}"
# Thumbnail drawn on the right of the banner. The banner icon says which terminal
# (Ghostty), so this says which *kind* of prompt: Claude's glyph by default, a
# question mark for AskUserQuestion, 1Password's when agent-1p-notify overrides
# it. .icns is accepted as-is.
#
# Whether the caller picked one has to be recorded before defaulting, so the
# per-event overrides further down can tell "unset" from "deliberately chosen"
# and leave agent-1p-notify's 1Password icon alone. The `-` (not `:-`) default
# then means AGENT_NOTIFY_IMAGE= drops the thumbnail entirely, and a missing
# file is skipped at send time rather than erroring.
AGENT_NOTIFY_IMAGE_SET="${AGENT_NOTIFY_IMAGE+1}"
AGENT_NOTIFY_IMAGE="${AGENT_NOTIFY_IMAGE-/Applications/Claude.app/Contents/Resources/electron.icns}"

# Resolve tmux-focus alongside this script; the notification click action runs
# with a bare PATH, and this file is normally reached through a ~/bin symlink.
TMUX_FOCUS=$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/tmux-focus

# macOS draws the banner's icon and name from the bundle that posted it, so
# posting through our own app (built by agent-notify-app, carrying the
# terminal's icon) is what turns the generic Terminal icon into Ghostty's. It is
# also what receives the click, so the fallback below only ever gets a banner on
# screen - clicking it does nothing until the app is built.
NOTIFIER_APP="$HOME/Applications/${AGENT_NOTIFY_APP_NAME:-Claude Code} Notify.app"
NOTIFIER="$NOTIFIER_APP/Contents/MacOS/agent-notifier"
[[ -x "$NOTIFIER" ]] || NOTIFIER="terminal-notifier"

# Deduplication: skip if same message sent within this many seconds
DEDUPE_WINDOW=30
DEDUPE_FILE="$HOME/.claude/manager/notify-last"

# How many of this session's background agents have not reported back yet, for
# the Stop guard below and for claude-manager-hook.sh, which announces this Mac's
# own sessions and has the same reason to stay quiet. Claude wakes a session
# whose task finished by queueing a <task-notification> carrying the tool_use id
# of the call that started it, so the ids launched since the last thing the user
# actually typed, minus the ids already reported back, is what is still out there.
pending_tasks() {
    local transcript="$1"
    [[ -f "$transcript" ]] || { echo 0; return; }
    tail -n 400 "$transcript" | jq -rs '
        ([ range(0; length) as $i
           | select(.[$i] | .type == "user"
                    and ((.message.content | type) == "string"
                         or (.message.content[0]?.type == "text")))
           | $i ] | last // -1) as $start
        | .[$start + 1:] as $turn
        | ([ $turn[] | select(.type == "assistant") | .message.content[]?
             | select(.type == "tool_use")
             | select(.name == "Agent" or .name == "Workflow"
                      or (.name == "Bash" and .input.run_in_background == true))
             | .id ] | unique) as $launched
        | ([ $turn[] | select(.type == "attachment") | .attachment
             | select(.type == "queued_command") | .prompt // ""
             | select(startswith("<task-notification>"))
             | capture("<tool-use-id>(?<id>[^<]*)</tool-use-id>").id ] | unique) as $done
        | ($launched - $done) | length' 2>/dev/null || echo 0
}

# Parse command line arguments
argv=("$@")
sender=""
recv=""
event=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --sender)
            sender="$2"
            shift 2
            ;;
        --recv)
            recv=1
            shift
            ;;
        --event)
            # Canonical agent-notify envelope on stdin (see the --event block
            # below). Used by the pi extension so a coding agent other than
            # Claude Code can drive the same backend without a hook schema.
            event=1
            shift
            ;;
        --pending-tasks)
            pending_tasks "$2"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# Read JSON from stdin
json=$(cat)

# A banner crosses two machines before anyone sees it, so "it showed up late" has
# several possible authors: the hook firing late, the wait for the reply text, the
# ssh, or macOS sitting on a notification it was handed promptly. Timestamping the
# stages settles which, and costs nothing when nobody is asking - create
# ~/.agent-notify-debug on both machines to start, delete it to stop.
NOTIFY_DEBUG="$HOME/.agent-notify-debug"
nlog() { [[ -e "$NOTIFY_DEBUG" ]] && echo "$(date '+%H:%M:%S') $$ $*" >> "$NOTIFY_DEBUG"; return 0; }
nlog "enter recv=${recv:-0} detached=${AGENT_NOTIFY_FOREGROUND:-0} event=$(echo "$json" | jq -r '.hook_event_name // "-"' 2>/dev/null)"

# Hand the rest to a detached copy and let the turn end. Everything below costs
# real time - up to two seconds waiting for the reply text to reach the transcript,
# another second of ssh out to the machine that has a screen - and Claude holds the
# turn open until its hook exits, so the session was paying for the banner's
# latency. It is a banner; it can arrive on its own. --recv is already running as
# somebody else's background work, and the ssh that invoked it wants its exit
# status, so that path stays in the foreground.
if [[ -z "$recv" && -z "$AGENT_NOTIFY_FOREGROUND" ]]; then
    printf '%s' "$json" |
        AGENT_NOTIFY_FOREGROUND=1 nohup "$0" ${argv[@]+"${argv[@]}"} >/dev/null 2>&1 &
    exit 0
fi

# One pass for every field that decides where this payload goes. Each was its own
# jq, and on a managed laptop with security software inspecting each new process a
# spawn costs 14ms against coop's 4 - enough of the banner's latency to be worth
# one awkward line. Unit separator rather than a tab, because IFS folds a run of
# whitespace into a single delimiter: a payload with no tool_name would hand every
# later field the value of the one before it. These five are identifiers and
# paths; the free text stays in its own calls below.
IFS=$'\037' read -r hook_session_id hook_tool hook_event hook_transcript hook_titled label_suffix <<<"$(
    echo "$json" | jq -r '[.session_id // "", .tool_name // "", .hook_event_name // "",
                           .transcript_path // "",
                           (if .title and .message then "1" else "" end),
                           .label_suffix // ""] | join("\u001f")' 2>/dev/null)"

# Locate this hook's entry in ~/.claude/sessions/, where Claude keeps one file
# per live session holding its name, sessionId and pid. Empty if not found.
claude_session_file() {
    local sid="$1" dir="$HOME/.claude/sessions" file pid

    # Hooks Claude invokes directly get .session_id on stdin.
    if [[ -n "$sid" ]]; then
        file=$(jq -r --arg sid "$sid" 'select(.sessionId == $sid) | input_filename' \
            "$dir"/*.json 2>/dev/null | head -1)
        [[ -n "$file" ]] && { echo "$file"; return; }
    fi

    # Wrappers (claude-manager-hook.sh, agent-1p-notify) synthesise their own
    # {title,message} payload and drop session_id, so walk up the process tree
    # instead: the hook is always a descendant of the claude process the file is
    # named for.
    pid=$$
    while [[ -n "$pid" && "$pid" -gt 1 ]]; do
        [[ -f "$dir/$pid.json" ]] && { echo "$dir/$pid.json"; return; }
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d "[:space:]")
    done
}

# stat's spelling differs between the machines this runs on, and neither one's
# flag is silently ignored by the other.
file_size() {
    stat -f %z "$1" 2>/dev/null || stat -c %s "$1" 2>/dev/null
}

# The AI-generated title Claude writes into the transcript ("Diagnose 16TB
# Seagate drive failure") — what /list-agents shows for a session you never
# named. Re-derived as the conversation moves on, so take the last one.
claude_ai_title() {
    local sid="$1" transcript titles

    for transcript in "$HOME/.claude/projects"/*/"$sid.jsonl"; do
        [[ -f "$transcript" ]] || continue
        # These land every few turns, so the tail almost always has one; only
        # walk a multi-megabyte transcript end to end when it doesn't.
        titles=$(tail -c 262144 "$transcript" | grep -a '"type":"ai-title"')
        [[ -z "$titles" ]] && titles=$(grep -a '"type":"ai-title"' "$transcript")
        printf '%s\n' "$titles" | tail -1 | jq -r '.aiTitle // empty' 2>/dev/null
        return
    done
}

# The pane on the *other* machine — the one running the ssh client this session
# is reached through, and so the one a notification from here should focus. Empty
# when nobody is connected, which just means the banner gets no click action.
#
# LC_AGENT_NOTIFY_PANE arrives through ssh's default `SendEnv LANG LC_*` /
# sshd's matching AcceptEnv, so no sshd configuration is involved. The agent has
# it in its own environment when it runs in the ssh session directly; inside a
# tmux over here it does not, because the tmux session outlives any one ssh
# connection — hence the file the login shell drops per tty, read through
# whichever client is attached right now. LC_CLAUDE_PANE and ~/.claude/origin
# remain read-only fallbacks for machines still migrating to the agent-neutral
# names.
origin_pane() {
    local session tty origin file legacy_file

    # Inside a tmux here, the attached client is the only current answer: the
    # session outlives connections, so the LC_AGENT_NOTIFY_PANE its panes
    # inherited names whichever pane happened to start the server, possibly days
    # ago.
    if [[ -n "${TMUX_PANE:-}" ]]; then
        session=$(tmux display-message -t "$TMUX_PANE" -p '#{session_name}' 2>/dev/null)
        tty=$(tmux list-clients -t "$session" -F '#{client_activity}|#{client_tty}' 2>/dev/null |
            sort -rn | head -1 | cut -d'|' -f2)
        if [[ -n "$tty" ]]; then
            file="$HOME/.agent-notify/origin/${tty//\//-}"
            legacy_file="$HOME/.claude/origin/${tty//\//-}"
            if [[ -f "$file" ]]; then
                origin=$(cat "$file" 2>/dev/null)
            else
                origin=$(cat "$legacy_file" 2>/dev/null)
            fi
        fi

        # Empty is the honest answer when this client never registered one. The
        # inherited value would still be there to fall back on and would still
        # name a live pane — just the wrong one, which is worse than none: the
        # receiver can recover from silence, not from a confident wrong pane.
        echo "$origin"
        return
    fi

    # Straight into the ssh session with no tmux, and the environment is right.
    echo "${LC_AGENT_NOTIFY_PANE:-${LC_CLAUDE_PANE:-}}"
}

# Get tmux info if available. Anchor to $TMUX_PANE — the pane THIS Claude process
# runs in (inherited by the hook) — not the active/focused pane. Without -t,
# display-message reports whichever pane is focused, so a notification from an
# unfocused pane would be mis-tagged (e.g. code:2.0 posted as code:1.0).
tmux_pane_id=""
if [[ -n "$TMUX_PANE" ]]; then
    tmux_info=$(tmux display-message -t "$TMUX_PANE" -p '#S:#{window_index}.#{pane_index}')
    tmux_pane_id="$TMUX_PANE"
elif [[ -n "$TMUX" ]]; then
    tmux_info=$(tmux display-message -p '#S:#{window_index}.#{pane_index}')
    tmux_pane_id=$(tmux display-message -p '#{pane_id}')
else
    tmux_info="Session"
fi

# Keep the raw tmux target for the notification click action, separate from
# whatever the banner ends up calling this pane. Empty means "not in tmux", so
# there is nothing to click through to.
#
# The pane id, not the coordinates: with renumber-windows on, closing any window
# shifts every index after it, so "code:6.0" baked in when the hook fired can
# belong to a different window — or to nothing — by the time the banner is
# clicked. A %id names the same pane for as long as it lives.
tmux_target="$tmux_pane_id"

# Append a caller-supplied qualifier to a label, unless it is already in there.
# Used by both label paths (hook and --event), so the rule lives in one place.
append_label_suffix() {
    local base="$1" suffix="$2"
    [[ -z "$suffix" || "$base" == "$suffix" || "$base" == *"$suffix" ]] && { printf '%s' "$base"; return; }
    printf '%s' "${base:+$base · }$suffix"
}

# What the notification calls this session, best name first: the one you gave it
# ("hd-recovery"), else the title Claude inferred, else the tmux coordinates —
# which only mean something once the layout is memorised. Clicking through lands
# on the same pane whichever it is.
session_file=""
[[ -z "$recv" && -z "$event" ]] && session_file=$(claude_session_file "$hook_session_id")
if [[ -n "$session_file" ]]; then
    label=$(jq -r '.name // empty' "$session_file" 2>/dev/null)
    [[ -z "$label" ]] && label=$(claude_ai_title "$(jq -r '.sessionId // empty' "$session_file" 2>/dev/null)")
fi
label="${label:-$tmux_info}"

# A caller that knows something the label does not can say so: agent-1p-notify
# passes the tmux coordinates, because a system-modal 1Password dialog has to
# name the pane it belongs to and several sessions in one project share a name.
# Skipped when the label already *is* that answer, which is exactly what happens
# when it fell back to $tmux_info: "code:6.0 · code:6.0" says nothing twice.
label=$(append_label_suffix "$label" "$label_suffix")

# Optional per-machine prefix so notifications from different hosts are
# distinguishable in a shared #notifications channel (e.g. "gfe:hd-recovery").
# Baked into the label so the desktop message and dedup hash agree with it.
if [[ -n "$AGENT_NOTIFY_HOST" ]]; then
    label="${AGENT_NOTIFY_HOST}:${label}"
fi

# Every Slack post from this pane carries the same header, so its thread stays
# the pane's thread even as the label follows a rename.
header=":claude: $label"

# Which agent this notification is about. Claude unless an --event envelope says
# otherwise, and it travels with a forwarded payload: the receiving machine has
# no other way to know, and drawing a pi notification out of the Claude bundle
# puts the wrong name and the wrong mark on someone else's work.
agent_name="claude"

# Where a click goes after it has focused $tmux_target, as HOST:SESSION:WINDOW.PANE.
# Only --recv sets it: a forwarded notification's local target is the pane holding
# the ssh, and this is the pane holding Claude on the far end of it.
remote_focus=""
remote_host=""
# Repeat notifications replace rather than stack, keyed by pane. Forwarded ones
# key on the sending machine's pane instead, since several of its sessions can
# share one ssh — and so one local pane.
notify_group=""
# Whether the sending machine's pane was on top of its own tmux when it fired.
# Only it could know; --recv fills this in from the payload.
remote_visible=""
# And whether a client with terminal focus was attached to it — an iPad in the
# next room is only ever visible to the machine holding that tmux.
remote_watched=""

# Forward mode: hand the whole notification to the machine the person is sitting
# at. Everything the banner needs is settled here, on the machine that knows it;
# the far end only draws it and works out which of *its* panes to focus.
forward_notification() {
    local payload host

    payload=$(jq -n \
        --arg label "$label" \
        --arg agent "$agent_name" \
        --arg header "$header" \
        --arg app "${AGENT_NOTIFY_APP_NAME:-}" \
        --arg subtitle "$1" \
        --arg message "$2" \
        --arg slack_body "$3" \
        --arg origin "$(origin_pane)" \
        --arg host "${AGENT_NOTIFY_HOST:-$(hostname -s)}" \
        --arg target "$tmux_target" \
        --arg visible "$(pane_visible_in_tmux && echo 1 || echo 0)" \
        --arg watched "$(pane_watched_in_tmux && echo 1 || echo 0)" \
        --arg slack "$AGENT_NOTIFY_SLACK" \
        --arg slack_away_only "$AGENT_NOTIFY_SLACK_AWAY_ONLY" \
        --arg slack_when_watched "$AGENT_NOTIFY_SLACK_WHEN_WATCHED" \
        '{label: $label, subtitle: $subtitle, message: $message,
          agent: $agent, header: $header, app: $app,
          slack_body: $slack_body, origin: $origin, host: $host, target: $target,
          visible: $visible, watched: $watched, slack: $slack,
          slack_away_only: $slack_away_only,
          slack_when_watched: $slack_when_watched}')

    nlog "forwarding to $AGENT_NOTIFY_FORWARD"
    for host in ${AGENT_NOTIFY_FORWARD//,/ }; do
        # The requested command is what runs if the key is unrestricted; the
        # authorized_keys forced command overrides it with the same thing.
        printf '%s' "$payload" |
            ssh -o BatchMode=yes -o ConnectTimeout=4 "$host" 'bin/agent-notify --recv' \
                >/dev/null 2>&1 && return 0
    done
    return 1
}

# Check for duplicate Slack messages
is_duplicate_slack() {
    local msg="$1"
    local msg_hash
    msg_hash=$(echo -n "$label:$msg" | md5 -q)
    local now
    now=$(date +%s)

    mkdir -p "$(dirname "$DEDUPE_FILE")"

    if [[ -f "$DEDUPE_FILE" ]]; then
        local last_hash
        last_hash=$(head -1 "$DEDUPE_FILE")
        local last_time
        last_time=$(tail -1 "$DEDUPE_FILE")

        if [[ "$msg_hash" == "$last_hash" ]] && [[ $((now - last_time)) -lt $DEDUPE_WINDOW ]]; then
            return 0  # is duplicate
        fi
    fi

    # Save this message
    echo "$msg_hash" > "$DEDUPE_FILE"
    echo "$now" >> "$DEDUPE_FILE"
    return 1  # not duplicate
}

# Check if the display is asleep (Apple Silicon compatible)
is_display_asleep() {
    python3 -c "
import ctypes, ctypes.util
cg = ctypes.cdll.LoadLibrary(ctypes.util.find_library('CoreGraphics'))
cg.CGMainDisplayID.restype = ctypes.c_uint32
cg.CGDisplayIsAsleep.restype = ctypes.c_int
cg.CGDisplayIsAsleep.argtypes = [ctypes.c_uint32]
exit(0 if cg.CGDisplayIsAsleep(cg.CGMainDisplayID()) else 1)
" 2>/dev/null
}

# True when a Screen Sharing/VNC client is driving this Mac. That is a form of
# away, not presence: the connection comes from a phone, zoomed into a corner of
# a desktop whose banners are mostly off-screen.
vnc_session_active() {
    # Spawned per connection, gone with the last one.
    pgrep -x screensharingd >/dev/null 2>&1 && return 0
    # A client that does not go through Apple's daemon still has to hold the
    # port open; same evidence, one layer down.
    netstat -an 2>/dev/null | awk '
        $1 ~ /^tcp/ && $4 ~ /\.5900$/ && $6 == "ESTABLISHED" { found = 1; exit }
        END { exit !found }
    '
}

# The question Slack actually cares about. A dark display is only half of it:
# someone can be driving this Mac from a phone with the screen off at the desk.
#
# Cached, because the Slack path asks twice — once as policy, once to decide
# whether a local terminal's focus flag is worth believing — and the display
# check spawns a python3 to ask CoreGraphics.
away_answer=""
user_is_away() {
    if [[ -z "$away_answer" ]]; then
        if is_display_asleep || vnc_session_active; then
            away_answer=yes
        else
            away_answer=no
        fi
    fi
    [[ "$away_answer" == "yes" ]]
}

# True when the pane this notification is about is already on screen. Every step
# has to agree, because guessing wrong here costs a notification you never see:
# Accessibility can be denied, the pane can be on another machine, the screen can
# be dark. "Cannot tell" has to mean notify.
# As much of "is this pane on screen" as tmux alone can answer: the active pane,
# of the active window, of a session someone is attached to. Anything less and it
# is behind something. Whether that tmux is itself in front is a question for
# whoever owns the display — here, or a machine away.
pane_visible_in_tmux() {
    local pane_active window_active attached

    [[ "$tmux_target" == %* ]] && command -v tmux >/dev/null 2>&1 || return 1
    read -r pane_active window_active attached <<<"$(tmux display-message \
        -t "$tmux_target" -p '#{pane_active} #{window_active} #{session_attached}' 2>/dev/null)"
    [[ "$pane_active" == 1 && "$window_active" == 1 && "${attached:-0}" -gt 0 ]]
}

# The ttys of clients attached to session $1 whose terminal says it currently
# holds keyboard focus. Terminals report that through DEC private mode 1004;
# tmux tracks it while focus-events is on and shows it as the `focused` flag.
#
# It is the only thing that ever reaches us from a screen we cannot see. Blink
# Shell on the iPad emits focus-out as iOS backgrounds the app and focus-in on
# return, while the ssh socket — and so the tmux client — survives being
# backgrounded: the client stays *attached* the whole time, which is why
# client_detached answers nothing here.
#
# Parsed rather than filtered with list-clients -f, which older tmux does not
# have, and matched with the commas in place so no other flag can read as this
# one.
focused_client_ttys() {
    local flags tty
    while IFS='|' read -r flags tty; do
        case ",$flags," in
            *,focused,*) printf '%s\n' "$tty" ;;
        esac
    done < <(tmux list-clients -t "=$1" -F '#{client_flags}|#{client_tty}' 2>/dev/null)
}

# True when somebody logged into $1 over the network. `who` prints the origin
# host in parentheses for an ssh login and stops at the timestamp for a terminal
# on this machine's own display.
tty_is_remote() {
    who 2>/dev/null | awk -v want="${1##*/}" '
        $2 == want && $NF ~ /^\(.+\)$/ { found = 1 }
        END { exit !found }
    '
}

# True when a person is reading this pane right now through some tmux client.
# On screen is not enough — a pane can be on top of a session nobody is looking
# at — so this adds the one thing a terminal can tell us that a layout cannot:
# that it has focus.
#
# A *local* client is only believed while this machine is not away. Nothing
# tells a terminal that the display went dark or that a VNC session took over:
# Ghostty stays "focused" for as long as it was the frontmost window, so a
# laptop left with an agent pane on top and the lid shut would swallow every
# Slack message from then on — the one case the away channel exists for. A
# focused client that came in over ssh is the opposite: a different screen
# entirely, and exactly the one we are trying to notice.
#
# Fails open at every step. No tmux, no pane id, a session that has gone, a
# `who` that says nothing: all of it means "cannot tell", and cannot tell means
# notify.
pane_watched_in_tmux() {
    local session ttys tty

    pane_visible_in_tmux || return 1
    session=$(tmux display-message -t "$tmux_target" -p '#{session_name}' 2>/dev/null)
    [[ -n "$session" ]] || return 1

    ttys=$(focused_client_ttys "$session")
    [[ -n "$ttys" ]] || return 1
    # Not away: a focused terminal is a person at a screen, wherever it is.
    user_is_away || return 0
    while read -r tty; do
        [[ -n "$tty" ]] && tty_is_remote "$tty" && return 0
    done <<<"$ttys"
    return 1
}

# Whether the reply is already on somebody's screen. Not "on screen here" —
# that is looking_at_target's narrower question, about this Mac's own frontmost
# terminal — but on whichever screen is reading this pane, which may be an iPad
# on the couch, or one two rooms away.
#
# Both callers want this and neither owns it: Slack because away has one more
# shape than a dark display, and the banner because a screen someone is reading
# does not need announcing to a Mac they are not at. The knob that turns each
# one off stays with its caller.
someone_is_watching() {
    # Two hops, two questions, the same split looking_at_target makes: only the
    # far end can see its own tmux, and it answered before forwarding. What is
    # left here is our pane — the one holding the ssh — which is showing the
    # agent only if the far end said its own pane was on top.
    if [[ "$remote_watched" == "1" ]]; then
        nlog "watched: the sender says somebody is reading its pane"
        return 0
    fi
    [[ -n "$remote_focus" && "$remote_visible" != "1" ]] && return 1
    if pane_watched_in_tmux; then
        nlog "watched: a client with terminal focus is showing this pane"
        return 0
    fi
    return 1
}

# The terminal tab a pane shows through. Same tag tmux-focus clicks on:
# set-titles-string expanded against the pane, minus the pane title, which Claude
# spins a glyph through several times a second.
tab_tag() {
    local fmt
    fmt=$(tmux show-options -gv set-titles-string 2>/dev/null)
    fmt=${fmt//\#T/}
    fmt=${fmt//\#\{pane_title\}/}
    [[ -n "$fmt" ]] || return 1
    tmux display-message -p -t "$tmux_target" "$fmt" 2>/dev/null
}

looking_at_target() {
    local tag selected

    [[ "$AGENT_NOTIFY_WHEN_VISIBLE" == "true" ]] && return 1

    # Somebody is reading this pane already, on some screen. That screen need
    # not be attached to this Mac: a notification about a reply being read on an
    # iPad becomes a banner nobody is there to dismiss, and they stack up until
    # whoever it was walks back to the desk. A focused client is also a better
    # answer than the tab hunt below, and a cheaper one — the terminal says it
    # holds keyboard focus rather than us inferring it through Accessibility —
    # so it gets asked first.
    someone_is_watching && return 0

    command -v osascript >/dev/null 2>&1 || return 1

    # Two hops, two questions. The far end answered its own before forwarding —
    # only it can see its tmux — so all that is left here is whether the ssh
    # session showing it is the tab in front.
    [[ -n "$remote_focus" && "$remote_visible" != "1" ]] && return 1

    case "$tmux_target" in
        # A plain ssh tab, addressed by the command Ghostty titles it with.
        tab:*) tag=${tmux_target#tab:} ;;
        %*)    pane_visible_in_tmux && tag=$(tab_tag) || return 1 ;;
        *)     return 1 ;;
    esac
    [[ -n "$tag" ]] || return 1
    # Cheap checks first: this one and the AppleScript below each cost more than
    # everything above them put together, and most notifications are about a pane
    # that is nowhere in sight. Frontmost says nothing once the display is off.
    is_display_asleep && return 1

    # Empty unless the terminal is frontmost, in which case the title of the tab
    # it is showing. AppleScript compares text without regard to case, which is
    # what we want: the process answers to "ghostty", the setting says "Ghostty".
    selected=$(osascript - "$AGENT_NOTIFY_TERMINAL" 2>/dev/null <<'APPLESCRIPT'
on run argv
  set appName to item 1 of argv
  tell application "System Events"
    set p to first process whose frontmost is true
    if name of p is not appName then return ""
    tell p
      if (count of windows) is 0 then return ""
      if exists tab group 1 of window 1 then
        repeat with t from 1 to (count of radio buttons of tab group 1 of window 1)
          if value of radio button t of tab group 1 of window 1 is true then
            return title of radio button t of tab group 1 of window 1
          end if
        end repeat
        return ""
      end if
      return title of window 1
    end tell
  end tell
end run
APPLESCRIPT
    )
    [[ -n "$selected" && "$selected" == *"$tag"* ]]
}

# slack-noti wants the webhook in its environment, and --recv has no environment
# to speak of: an ssh forced command reaches neither the GUI session's launchd
# variables nor the login keychain fnox keeps them in. Copying the secret to disk
# — or onto coop — to fix that is far more than a notification is worth. The tmux
# server does have it, having been started from a login shell in the GUI session,
# so hand it the post and let it supply the environment.
slack_post() {
    local msg="$1"

    if [[ -n "${BOEHS_SLACK_NOTI_HOOK:-}" ]]; then
        slack-noti "$msg"
    elif command -v tmux >/dev/null 2>&1 && tmux has-session 2>/dev/null; then
        # -b so a slow webhook never holds up the hook that is waiting on us,
        # and silenced because tmux surfaces a run-shell's output in the client:
        # curl's "ok" would otherwise land in whatever pane you were looking at.
        tmux run-shell -b "$(printf '%q %q' "$HOME/bin/slack-noti" "$msg") >/dev/null 2>&1"
    fi
}

# Send notification. The session label is the banner *title* — the one line
# macOS always shows in full and never truncates — so a glance at a stack of
# banners says which session each came from. What happened goes in the subtitle
# ("Claude Code Stopped"), and the detail in the message.
# Notification Center draws plain text, so every markdown marker in a message
# survives as literal noise on the banner: asterisks around the words they were
# meant to bold, backticks around a branch name, a whole URL after the link text
# that already said where it goes. Strip the markers and keep the words. Slack
# gets the message untouched, since there the markup is the point.
#
# Emphasis has to insist on a non-space after the marker, or a "* item" bullet
# would pair up with the next one on the line and eat everything between them.
banner_text() {
    printf '%s' "$1" | perl -0pe '
        s/```[a-zA-Z]*\n?//g;
        s/\[([^\]\n]+)\]\([^)\n]+\)/$1/g;
        s/<[^>|\n]+\|([^>\n]+)>/$1/g;
        s/^\s{0,3}#{1,6}\s+//mg;
        s/^\s{0,3}>\s?//mg;
        s/\*\*(\S(?:[^*]*\S)?)\*\*/$1/g;
        s/(?<!\*)\*(\S(?:[^*\n]*\S)?)\*(?!\*)/$1/g;
        s/`([^`\n]+)`/$1/g;
    ' 2>/dev/null || printf '%s' "$1"
}

send_notification() {
    local subtitle="$1"
    local message="$2"
    local slack_header="${3:-$header}"
    local slack_body="${4:-$message}"
    nlog "send_notification entered"

    # Nothing local to draw on. Slack is posted by the far end (it holds the
    # webhook), but under *our* policy, which rides along in the payload.
    if [[ -n "${AGENT_NOTIFY_FORWARD:-}" ]]; then
        forward_notification "$subtitle" "$message" "$slack_body"
        return
    fi

    # Clicking a banner should land on the pane that sent it. -execute runs on
    # click (the default is to do nothing at all), and -group makes a repeat
    # notification from the same pane replace the previous one rather than
    # stacking up in Notification Center.
    local -a notifier_args=(-title "$label" -message "$(banner_text "$message")")
    # A subtitle is optional and mostly unwanted: claude-manager-hook.sh has no
    # event name to give beyond a placeholder "Claude", and a plain stop passes
    # none at all. Drop both rather than spend the line saying nothing.
    [[ -n "$subtitle" && "$subtitle" != "Claude" ]] && notifier_args+=(-subtitle "$subtitle")
    [[ -f "$AGENT_NOTIFY_IMAGE" ]] && notifier_args+=(-contentImage "$AGENT_NOTIFY_IMAGE")
    # A group is what makes a session's second banner replace its first instead
    # of stacking, so every notification wants one, click target or not. The pane
    # is the natural identity when there is one; without it fall back to the
    # label, which names the session. Two sessions outside tmux on the same box
    # used to land on the same empty-pane group and quietly overwrite each other.
    notifier_args+=(-group "${notify_group:-claude-${tmux_target:-$label}}")
    if [[ -n "$tmux_target" ]]; then
        notifier_args+=(
            -execute "$(printf '%q %q %q %q' "$TMUX_FOCUS" "$tmux_target" \
                "$AGENT_NOTIFY_TERMINAL" "$remote_focus")"
        )
    fi

    # Nothing to announce about a pane you are already watching.
    if looking_at_target; then
        nlog "suppressed, pane is on screen"
        :
    # Only check if iTerm2 is frontmost when --sender com.googlecode.iterm2 is passed
    elif [[ "$sender" == "com.googlecode.iterm2" ]]; then
        local frontmost_app
        frontmost_app=$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true')
        if [[ "$frontmost_app" != "iTerm2" ]]; then
            "$NOTIFIER" "${notifier_args[@]}"
        fi
    else
        nlog "drawing [$label] ${message:0:60}"
        "$NOTIFIER" "${notifier_args[@]}"
        nlog "drawn rc=$?"
    fi

    # Send Slack notification if enabled (with deduplication)
    # AGENT_NOTIFY_SLACK=false disables all Slack notifications
    # AGENT_NOTIFY_SLACK_AWAY_ONLY=true sends only when away (asleep or VNC)
    if [[ "$AGENT_NOTIFY_SLACK" == "true" ]]; then
        local should_send=true
        if [[ "$AGENT_NOTIFY_SLACK_AWAY_ONLY" == "true" ]]; then
            if ! user_is_away; then
                should_send=false
                nlog "slack skipped, not away"
            fi
        fi
        if [[ "$should_send" == "true" && "$AGENT_NOTIFY_SLACK_WHEN_WATCHED" != "true" ]] &&
            someone_is_watching; then
            should_send=false
            nlog "slack skipped, pane is being read"
        fi
        if [[ "$should_send" == "true" ]]; then
            local full_msg="$slack_header"$'\n\n'"$slack_body"
            if ! is_duplicate_slack "$full_msg"; then
                slack_post "$full_msg"
            fi
        fi
    fi
}

# --event: the canonical envelope produced by a non-Claude agent (currently the
# pi extension). Unlike the Claude hook paths, the label, body and event type
# arrive pre-resolved by the producer, so there is nothing to scrape from a
# transcript. The click target is still this pane, exactly like a local Stop.
#
# Envelope (JSON on stdin):
#   { "version": 1, "agent": "pi", "event": "settled|question|attention",
#     "session_id": "...", "session_name": "...", "cwd": "...",
#     "message": "...", "slack_body": "...", "subtitle": "..." }
#
# message and slack_body are deliberately separate. A banner gets two lines on
# screen and wants the answer; Slack has room for the whole reply and keeps its
# line breaks. The producer decides what belongs in each, and slack_body falls
# back to message when it has nothing extra to say.
if [[ -n "$event" ]]; then
    ev=$(echo "$json" | jq -r '.event // "settled"')
    # Named by the producer, and it travels: a forwarded notification is drawn on
    # a machine that never saw this envelope.
    agent_name=$(echo "$json" | jq -r '.agent // "pi"')
    # Best name first: the name the agent gave the session, else the project
    # directory's basename, else the tmux coordinates.
    label=$(echo "$json" | jq -r '.session_name // empty')
    if [[ -z "$label" ]]; then
        cwd=$(echo "$json" | jq -r '.cwd // empty')
        label="${cwd##*/}"
    fi
    label="${label:-$tmux_info}"
    label=$(append_label_suffix "$label" "$label_suffix")
    [[ -n "$AGENT_NOTIFY_HOST" ]] && label="${AGENT_NOTIFY_HOST}:${label}"
    header="${AGENT_NOTIFY_EMOJI:-:robot_face:} $label"
    # Key pi banners separately from Claude's so the two agents' notifications
    # replace within their own agent but never clobber each other on one pane.
    notify_group="pi-${tmux_target:-$label}"
    subtitle=$(echo "$json" | jq -r '.subtitle // empty')
    body=$(echo "$json" | jq -r '.message // empty')
    [[ -z "$body" ]] && body="Ready for further instruction."
    slack_body=$(echo "$json" | jq -r '.slack_body // empty')
    [[ -z "$slack_body" ]] && slack_body="$body"
    # A question is blocked on an answer, not merely finished: give it the
    # question glyph unless the caller pinned an explicit image.
    if [[ "$ev" == "question" || "$ev" == "attention" ]]; then
        [[ -z "$subtitle" ]] && subtitle="Waiting on your answer"
        question_icon="$NOTIFIER_APP/Contents/Resources/question.png"
        [[ -z "${AGENT_NOTIFY_IMAGE_SET:-}" && -f "$question_icon" ]] && AGENT_NOTIFY_IMAGE="$question_icon"
    else
        # Otherwise the agent's own mark, the way a Claude banner carries
        # Claude's: the app icon on the left stays the terminal's, because the
        # banner is still about that window. The default is Claude's app icon,
        # which would be a lie here.
        agent_icon="$NOTIFIER_APP/Contents/Resources/pi.png"
        [[ -z "${AGENT_NOTIFY_IMAGE_SET:-}" && -f "$agent_icon" ]] && AGENT_NOTIFY_IMAGE="$agent_icon"
    fi
    send_notification "$subtitle" "$body" "$header" "$slack_body"
    exit 0
fi

# --recv: a notification forwarded from another machine's agent-notify. Its
# label, event and body are settled; what is left is the click target, and that
# is two panes deep — the local one holding the ssh session, then the pane on the
# far side running Claude.
if [[ -n "$recv" ]]; then
    label=$(echo "$json" | jq -r '.label // "Remote"')
    # Whose notification this is. An older sender says nothing, and everything it
    # could have sent was Claude's, so that is the fallback.
    agent_name=$(echo "$json" | jq -r '.agent // "claude"')
    header=$(echo "$json" | jq -r '.header // empty')
    [[ -z "$header" ]] && header=":claude: $label"
    # Draw from the agent's own bundle. macOS takes a notification's name and icon
    # from whichever bundle posts it, so this is what stops a pi banner arriving
    # under Claude's name. --recv runs as a forced command with no environment to
    # speak of, which is why the sender's choice has to ride in the payload rather
    # than be inherited.
    recv_app=$(echo "$json" | jq -r '.app // empty')
    if [[ -n "$recv_app" ]]; then
        AGENT_NOTIFY_APP_NAME="$recv_app"
        NOTIFIER_APP="$HOME/Applications/$recv_app Notify.app"
        # The binary path was settled at startup from this machine's own default,
        # before there was a payload to read, so it has to be re-derived here -
        # including the terminal-notifier fallback, in case the sender names a
        # bundle this machine has never built.
        NOTIFIER="$NOTIFIER_APP/Contents/MacOS/agent-notifier"
        [[ -x "$NOTIFIER" ]] || NOTIFIER="terminal-notifier"
    fi
    # The thumbnail is this machine's to resolve: the sender's path means nothing
    # here, but the mark lives in the bundle just chosen.
    if [[ "$agent_name" == "pi" && -z "${AGENT_NOTIFY_IMAGE_SET:-}" ]]; then
        agent_icon="$NOTIFIER_APP/Contents/Resources/pi.png"
        [[ -f "$agent_icon" ]] && AGENT_NOTIFY_IMAGE="$agent_icon"
    fi
    tmux_target=$(echo "$json" | jq -r '.origin // empty')
    # No pane means the ssh was started from a plain terminal tab rather than
    # from inside a tmux. Nothing to select, so address the tab by the title
    # Ghostty gives it — its command line — and skip tmux on this end entirely.
    # Wrapping that ssh in a local tmux purely to have a pane id would mean
    # nesting a tmux inside a tmux, which is a worse trade than matching a title.
    if [[ -z "$tmux_target" ]]; then
        remote_host=$(echo "$json" | jq -r '.host // empty')
        [[ -n "$remote_host" ]] && tmux_target="tab:ssh $remote_host"
    fi
    remote_visible=$(echo "$json" | jq -r '.visible // ""')
    remote_watched=$(echo "$json" | jq -r '.watched // ""')
    remote_focus=$(echo "$json" | jq -r 'if (.host // "") != "" and (.target // "") != ""
                                         then "\(.host):\(.target)" else "" end')
    # The sender's pane, not ours: it is what tells two agents on the same box
    # apart. Headless there is no pane, so its label stands in. Keyed by agent as
    # well, so pi and Claude forwarding from one machine cannot replace each
    # other's banners.
    notify_group="$agent_name-$(echo "$json" | jq -r '
        (.host // "remote") + "-" +
        (if (.target // "") != "" then .target else (.label // "") end)')"
    # Whether to post to Slack at all is the sender's call; whether anyone is
    # here to see a banner is still ours to measure, so only the policy travels.
    # slack_sleep_only is what an older sender calls the same field.
    AGENT_NOTIFY_SLACK=$(echo "$json" | jq -r '.slack // "true"')
    AGENT_NOTIFY_SLACK_AWAY_ONLY=$(echo "$json" |
        jq -r '.slack_away_only // .slack_sleep_only // "false"')
    AGENT_NOTIFY_SLACK_WHEN_WATCHED=$(echo "$json" | jq -r '.slack_when_watched // "false"')
    send_notification \
        "$(echo "$json" | jq -r '.subtitle // empty')" \
        "$(echo "$json" | jq -r '.message // empty')" \
        "$header" \
        "$(echo "$json" | jq -r '.slack_body // .message // empty')"
    exit 0
fi

# AskUserQuestion (PreToolUse hook): Claude is waiting on the user to choose.
# Post the actual question(s) and numbered options, so the Slack message says what
# is being asked and can be answered from the Claude app without walking back.
if [[ "$hook_tool" == "AskUserQuestion" ]]; then
    body=$(echo "$json" | jq -r '
        .tool_input.questions[]? as $q
        | "*\($q.header // "Question")*\(if $q.multiSelect then " (choose any)" else "" end): \($q.question)"
          + ( [ $q.options | to_entries[]
                | "\n  \(.key + 1). \(.value.label)"
                  + (if (.value.description // "") != "" then " — \(.value.description)" else "" end)
              ] | join("") )
    ' 2>/dev/null)
    [[ -z "$body" ]] && body="Claude is asking for your input."
    # Slack gets every question and option; the banner gets the first question,
    # stripped of the *bold* markers Slack wants.
    desktop_body=$(printf '%s\n' "$body" | head -1 | tr -d '*')
    [[ -z "$desktop_body" ]] && desktop_body="Claude is asking for your input."
    # This one is blocked on an answer, not just finished — a question mark
    # separates it from a Stop banner without having to read the text. Only
    # overrides the default, so an explicit AGENT_NOTIFY_IMAGE still wins.
    question_icon="$NOTIFIER_APP/Contents/Resources/question.png"
    [[ -z "${AGENT_NOTIFY_IMAGE_SET:-}" && -f "$question_icon" ]] && AGENT_NOTIFY_IMAGE="$question_icon"
    send_notification "Waiting on your answer" "$desktop_body" "$header" "$body"
    exit 0
fi

# Notification event (a permission/approval prompt, or an idle "waiting for your
# input" nudge). Claude Code fires this with a ready-made human-readable .message
# but no .title — handle it before the title+message check so it doesn't fall
# through to the generic Stop path.
if [[ "$hook_event" == "Notification" ]]; then
    [[ "$AGENT_NOTIFY_PERMISSION" == "true" ]] || exit 0
    body=$(echo "$json" | jq -r '.message // "Claude needs your attention."')
    # Skip the idle "waiting for your input" nudge: it fires ~60s after the agent
    # stops (already covered by the Stop hook) and is just noise. Only surface
    # actionable notifications like permission/approval prompts.
    lc=$(echo "$body" | tr '[:upper:]' '[:lower:]')
    case "$lc" in
        *"waiting for your input"*) exit 0 ;;
    esac
    send_notification "Claude needs your attention" "$body" "$header" "$body"
    exit 0
fi

# Check if this is a notification with title/message or a stop hook
if [[ -n "$hook_titled" ]]; then
    # Notification payload
    title=$(echo "$json" | jq -r '.title')
    body=$(echo "$json" | jq -r '.message')
    send_notification "$title" "$body" "$header" "$body"
else
    # A turn that ends while its own background agents are still running is not
    # the session finishing, it is the session waiting - and each of those agents
    # wakes it again on its way out, so a /pr-review-toolkit:review-pr fanning
    # out to six reviewers announced itself six times. Wait for the last one and
    # draw a single banner, for the turn that has the whole review in it.
    if [[ "$hook_event" == "Stop" ]] && [[ "$(pending_tasks "$hook_transcript")" -gt 0 ]]; then
        nlog "suppressed, background tasks still running"
        exit 0
    fi

    # Stop hook payload. On this Mac the Stop hook is claude-manager-hook.sh,
    # which reads the transcript and hands the last thing Claude said down as a
    # title+message pair, so this branch only ever ran as a fallback. A headless
    # box has no manager and calls us directly, and "Ready for further
    # instruction." on every banner says nothing about which agent wants what.
    # So do the same lookup here: slurping needs whole lines, and the tail keeps
    # a long session from being read end to end for its last few hundred.
    # Claude hands the finished reply to the hook that announces it, which is the
    # whole question this branch used to answer the hard way - tailing the
    # transcript and waiting for the message to land in it. Keep the old path for
    # payloads without the field: claude-manager-hook.sh synthesises its own, and
    # an older Claude on another machine may not send one.
    body=$(echo "$json" | jq -r '.last_assistant_message // empty' 2>/dev/null)
    transcript="$hook_transcript"
    if [[ -z "$body" && -n "$transcript" && -f "$transcript" ]]; then
        # Claude appends the message it just finished *after* firing this hook, so
        # reading immediately hands back the turn before last. Wait for a message
        # newer than the last thing on the user side of the log — the real prompt,
        # or the tool result that ended the last round trip — since the reply that
        # ends a turn is always written after it. Two seconds of tenths, then give
        # up rather than wait on a turn with no closing text to come.
        #
        # Three answers, not two, because "no text yet" and "no text coming" want
        # opposite things and look alike. Once a message newer than the user side
        # has landed, that *is* the end of the turn: if it carries text we have the
        # body, and if it carries only a tool call then nothing further is coming
        # and every remaining attempt is two seconds spent confirming it. Only the
        # third answer - nothing landed at all - is worth another tenth of a second.
        #
        # Re-read only when the file has actually grown, so the tenths that remain
        # cost a stat rather than a parse of the last four hundred lines.
        prev_size=""
        for _ in $(seq 20); do
            size=$(file_size "$transcript")
            if [[ "$size" == "$prev_size" ]]; then
                sleep 0.1
                continue
            fi
            prev_size="$size"
            reply=$(tail -n 400 "$transcript" | jq -rs '
                (([.[] | select(.type == "user") | .timestamp // empty] | last) // "") as $after
                | [.[] | select(.type == "assistant")
                       | select((.timestamp // "") > $after)] as $ended
                | ($ended | map(select(.message.content[]?.type == "text")) | last) as $m
                | if $m then "text\n" + ([$m.message.content[]
                                           | select(.type == "text") | .text] | join("\n"))
                  elif ($ended | length) > 0 then "silent"
                  else empty end' 2>/dev/null)
            case "$reply" in
                silent) break ;;
                text*)  body=${reply#text$'\n'}; break ;;
            esac
            sleep 0.1
        done
    fi
    [[ -z "$body" ]] && body="Ready for further instruction."
    # No subtitle: a stop is the ordinary case, and "Claude Code Stopped" over
    # every banner is a line spent saying what the absence of a subtitle already
    # says. The ones that do carry it are the exceptions worth noticing — a
    # question waiting on an answer, a permission prompt.
    send_notification "" "$body" "$header" "$body"
fi

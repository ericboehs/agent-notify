#!/usr/bin/env bash
# Focus a tmux pane from outside tmux: point a client at it, then bring the
# terminal app forward.
#
# Usage: tmux-focus TARGET [APP] [REMOTE_HOST:REMOTE_TARGET]
#
#   TARGET  a %pane_id (preferred — survives renumbering), SESSION:WINDOW.PANE,
#           or tab:TEXT to skip tmux entirely and just click the terminal tab
#           whose title contains TEXT. An ssh started from a plain tab has no
#           pane to select, and nesting a local tmux around it only to gain one
#           is a worse trade than matching on the title.
#   REMOTE  a machine reached through an ssh session running in TARGET, plus the
#           pane to focus in *its* tmux. Claude on coop notifies through the Mac,
#           so the click has two hops: the local tab or pane holding the ssh,
#           then the remote pane holding Claude.
#
# Used as terminal-notifier's -execute action so clicking a Claude Code
# notification lands on the pane that sent it, instead of doing nothing.

set -uo pipefail

target=${1:-}
app=${2:-Ghostty}
remote=${3:-}
[ -n "$target" ] || exit 0

# Notification Center spawns this with a bare PATH, so Homebrew is not on it.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Same log the notifier writes to, and the same switch: create
# ~/.claude-notify-debug to start, delete it to stop. A click either lands on
# the right pane or it does not, and the difference between "tmux moved and the
# tab click failed" and "tmux never moved" is otherwise invisible after the fact.
NOTIFY_DEBUG="$HOME/.claude-notify-debug"
flog() { [ -e "$NOTIFY_DEBUG" ] && echo "$(date '+%H:%M:%S') tmux-focus $*" >> "$NOTIFY_DEBUG"; return 0; }
flog "click target=$target app=$app remote=${remote:-none}"

# tab:TEXT addresses a terminal tab directly. There is no local pane to select,
# so the tmux half is skipped and only the second hop and the tab click run.
tab_match=""
case "$target" in
  tab:*) tab_match=${target#tab:}; target="" ;;
esac

[ -n "$target" ] && ! command -v tmux >/dev/null 2>&1 && exit 0

# Notifications carry a %pane_id where they can, because a pane keeps it for life
# while its session:window.pane shifts under renames and renumbering. Keep the id
# all the way to select-pane: resolving it to coordinates here and then selecting
# by those coordinates puts back exactly the race the id was chosen to avoid.
# With renumber-windows on, one window closing shifts every index after it, so
# "code:2.1" can name a different pane than the one that asked for attention.
# tmux resolves a pane id for switch-client, select-window and select-pane alike.
if [ -n "$target" ]; then
  case "$target" in
    %*) pane=$target ;;
    *)  pane=$(tmux display-message -t "$target" -p '#{pane_id}' 2>/dev/null) ;;
  esac

  # Still wanted as text: picking a client is a per-session question, and the
  # tab tag falls back to the session name further down.
  session=$(tmux display-message -t "$pane" -p '#{session_name}' 2>/dev/null)

  if [ -n "$pane" ] && [ -n "$session" ] && tmux has-session -t "=$session" 2>/dev/null; then
    # Prefer a client already showing this session, so a click never yanks an
    # unrelated window off whatever it was on; otherwise take the most recently
    # active client. Delimit with | because session names may contain spaces.
    client=$(tmux list-clients -F '#{client_activity}|#{client_session}|#{client_tty}' |
      sort -rn | awk -F'|' -v s="$session" '$2 == s { print $3; exit }')
    [ -n "$client" ] || client=$(tmux list-clients -F '#{client_activity}|#{client_tty}' |
      sort -rn | awk -F'|' 'NR == 1 { print $2 }')

    flog "resolved pane=$pane session=$session client=${client:-none} from=$(tmux display-message -p '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)"

    # Without -c there is no current client to infer, so it would pick arbitrarily.
    [ -n "$client" ] && tmux switch-client -c "$client" -t "$pane"
    tmux select-window -t "$pane"
    tmux select-pane -t "$pane"

    flog "after tmux focus=$(tmux display-message -p '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null) target_active=$(tmux display-message -t "$pane" -p '#{pane_active}#{window_active}' 2>/dev/null)"
  else
    flog "no tmux move (pane=${pane:-none} session=${session:-none})"
  fi
fi

# Second hop: the pane we just focused holds an ssh session, and the Claude that
# sent this is in a tmux over there. Same script, no app to raise on that end.
# Backgrounded so a sleeping or unreachable box cannot stall the local focus.
if [ -n "$remote" ]; then
  rhost=${remote%%:*}
  rtarget=${remote#*:}
  # Unlike every other argument, this one arrived over the network from the box
  # being notified, and both halves end up on a command line: the host in ssh's
  # own arguments, the target in a command the remote shell parses. So take only
  # a plain hostname and a plain tmux target. A leading dash would otherwise
  # smuggle `-oProxyCommand=...`, which runs here, on the Mac; a metacharacter in
  # the target would run over there. Anything stranger just loses the second hop.
  case $rhost in ''|-*|*[!A-Za-z0-9._-]*) rhost= ;; esac
  case $rtarget in ''|*[!A-Za-z0-9._%:-]*) rtarget= ;; esac
  [ -n "$rhost" ] && [ -n "$rtarget" ] &&
    ssh -o BatchMode=yes -o ConnectTimeout=4 -- "$rhost" \
      "bin/tmux-focus $rtarget" >/dev/null 2>&1 &
fi

# Everything below is macOS-only; on Linux the tmux focus above is the whole job.
command -v osascript >/dev/null 2>&1 || exit 0

# A pane that no longer exists has no tab worth raising either. Stop before both
# hops: every tag below is a substring match, and an empty session degrades
# "$session:" to ":", which matches the first tmux tab in the window - sending a
# stale click somewhere it was never aimed. Yanking the terminal forward for a
# pane that is gone is its own small lie.
if [ -n "$target" ] && [ -z "${session:-}" ]; then
  flog "stale target $target, terminal left alone"
  exit 0
fi

open -a "$app"


# Raising the app lands on whatever tab it was last showing, which need not be
# the one running tmux. Nothing in Ghostty's CLI can focus an existing surface
# (+new-window is the only IPC it has), so drive the tab bar through the
# accessibility API instead: macOS tabs are radio buttons in the window's tab
# group, and clicking one selects it.
#
# Ways to recognise the tab, tried best first:
#   - with tmux `set-titles on`, expand set-titles-string against the pane we
#     just focused: that is character for character the title tmux hands the
#     terminal, so it picks out one tab even when an ssh tab next to it shows a
#     remote tmux whose session is also called "code";
#   - failing that, any tab bearing the session name, which is wrong only when a
#     remote session shares it;
#   - failing that, tmux sets no title at all and Ghostty falls back to the
#     command ("tmux -u attach"), which singles the tab out as long as only one
#     tab runs tmux.
# Silent on failure by design: this is a nicety on top of a focus that already
# happened, and it needs the calling app to hold Accessibility permission.
if [ -n "$tab_match" ]; then
  # A bare ssh tab is titled by its command ("ssh coop"), so pass 1 matches that
  # exactly and pass 2 settles for the bare hostname — enough to survive the tab
  # being renamed by a remote tmux that sets titles.
  tags=("$tab_match")
  [ -n "${remote%%:*}" ] && tags+=("${remote%%:*}")
else
  tags=()
  if [ -n "$target" ]; then
    # Expand set-titles-string against the pane, minus the pane title: Claude
    # spins a glyph through it several times a second, so a title captured here
    # need not be the one Ghostty is showing a moment later. What is left is
    # "code:4 " — enough to tell the local session apart from an ssh tab whose
    # remote tmux is also called "code", and it holds still.
    title_fmt=$(tmux show-options -gv set-titles-string 2>/dev/null)
    title_fmt=${title_fmt//\#T/}
    title_fmt=${title_fmt//\#\{pane_title\}/}
    [ -n "$title_fmt" ] &&
      prefix=$(tmux display-message -p -t "$target" "$title_fmt" 2>/dev/null)
    [ -n "${prefix:-}" ] && tags+=("$prefix")
  fi
  tags+=("$session:" tmux)
fi

# The tab hop is the one that fails invisibly: a revoked Accessibility grant and
# a tag that matched nothing look identical from out here, and both leave you on
# the wrong tab. So the script reports what it did, and that goes to the same log
# as the rest rather than being discarded.
#
# Via a temp file rather than $(osascript ... <<EOF): bash 3.2 mis-parses a
# heredoc inside a command substitution, scanning the body for shell quotes and
# choking on the apostrophe below. That matters because the notifier bundle
# launches this through /bin/sh with a minimal PATH, where `env bash` finds
# /bin/bash 3.2 - not whatever modern bash sits on an interactive PATH.
focus_out=$(mktemp -t tmux-focus)
osascript - "$app" "${tags[@]}" >"$focus_out" 2>&1 <<'APPLESCRIPT' || true
on run argv
  set appName to item 1 of argv
  set tags to rest of argv
  tell application "System Events"
    if not (exists process appName) then return "no process " & appName
    tell process appName
      -- Address every element by index. System Events hands back element
      -- references keyed by *name*, and selecting a tab renames the window it
      -- lives in, so anything captured up front goes stale mid-loop.
      set winCount to count of windows
      repeat with tag in tags
        repeat with w from 1 to winCount
          if exists tab group 1 of window w then
            repeat with t from 1 to (count of radio buttons of tab group 1 of window w)
              if my matches(title of radio button t of tab group 1 of window w, tag) then
                set act to "already-on"
                if value of radio button t of tab group 1 of window w is false then
                  click radio button t of tab group 1 of window w
                  set act to "clicked"
                end if
                perform action "AXRaise" of window w
                return act & " win" & w & " tab" & t & " tag=" & (tag as text)
              end if
            end repeat
          else if my matches(title of window w, tag) then
            perform action "AXRaise" of window w
            return "raised win" & w & " tag=" & (tag as text)
          end if
        end repeat
      end repeat
      return "no tab matched"
    end tell
  end tell
end run

-- `contains`, not `starts with`: Ghostty prefixes a tab that rang the bell with
-- a 🔔, and tmux's set-titles-string can lead with alert markers of its own.
on matches(t, tag)
  if t is missing value then return false
  return t contains tag
end matches
APPLESCRIPT
flog "tab hop tags=[${tags[*]}] result=$(tr '\n' ' ' < "$focus_out")"
rm -f "$focus_out"

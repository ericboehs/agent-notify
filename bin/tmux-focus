#!/usr/bin/env bash
# Focus a tmux pane from outside tmux: point a client at it, then bring the
# terminal app forward.
#
# Usage: tmux-focus TARGET [APP] [REMOTE_HOST:REMOTE_TARGET]
#
#   TARGET  a %pane_id (preferred — survives renumbering) or SESSION:WINDOW.PANE
#   REMOTE  a machine reached through an ssh session running in TARGET, plus the
#           pane to focus in *its* tmux. Claude on coop notifies through the Mac,
#           so the click has two hops: the local pane holding the ssh, then the
#           remote pane holding Claude.
#
# Used as terminal-notifier's -execute action so clicking a Claude Code
# notification lands on the pane that sent it, instead of doing nothing.

set -uo pipefail

target=${1:-}
app=${2:-Ghostty}
remote=${3:-}
[ -n "$target" ] || exit 0

# Notification Center spawns this with a bare PATH, so Homebrew is not on it.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

command -v tmux >/dev/null 2>&1 || exit 0

# Notifications carry a %pane_id where they can, because a pane keeps it for life
# while its session:window.pane shifts under renames and renumbering. Resolve it
# to coordinates now, at click time, when it means something.
case "$target" in
  %*) target=$(tmux display-message -t "$target" -p '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null) ;;
esac
[ -n "$target" ] || exit 0

session=${target%%:*}
window=${target%.*}  # select-window rejects the .pane suffix

tmux has-session -t "=$session" 2>/dev/null || exit 0

# Prefer a client already showing this session, so a click never yanks an
# unrelated window off whatever it was on; otherwise take the most recently
# active client. Delimit with | because session names may contain spaces.
client=$(tmux list-clients -F '#{client_activity}|#{client_session}|#{client_tty}' |
  sort -rn | awk -F'|' -v s="$session" '$2 == s { print $3; exit }')
[ -n "$client" ] || client=$(tmux list-clients -F '#{client_activity}|#{client_tty}' |
  sort -rn | awk -F'|' 'NR == 1 { print $2 }')

# Without -c there is no current client to infer, so it would pick arbitrarily.
[ -n "$client" ] && tmux switch-client -c "$client" -t "=$session"
tmux select-window -t "$window"
tmux select-pane -t "$target"

# Second hop: the pane we just focused holds an ssh session, and the Claude that
# sent this is in a tmux over there. Same script, no app to raise on that end.
# Backgrounded so a sleeping or unreachable box cannot stall the local focus.
if [ -n "$remote" ]; then
  ssh -o BatchMode=yes -o ConnectTimeout=4 "${remote%%:*}" \
    "bin/tmux-focus ${remote#*:}" >/dev/null 2>&1 &
fi

# Everything below is macOS-only; on Linux the tmux focus above is the whole job.
command -v osascript >/dev/null 2>&1 || exit 0

open -a "$app"

# Raising the app lands on whatever tab it was last showing, which need not be
# the one running tmux. Nothing in Ghostty's CLI can focus an existing surface
# (+new-window is the only IPC it has), so drive the tab bar through the
# accessibility API instead: macOS tabs are radio buttons in the window's tab
# group, and clicking one selects it.
#
# Two ways to recognise the tab, best first:
#   - with tmux `set-titles on`, the terminal title is #S:#I:#W, so the tab
#     titled "code:..." is the one whose client we just moved;
#   - without it tmux sets no title at all and Ghostty falls back to the command
#     ("tmux -u attach"), which still singles the tab out as long as only one
#     tab is running tmux.
# Silent on failure by design: this is a nicety on top of a focus that already
# happened, and it needs the calling app to hold Accessibility permission.
osascript - "$app" "$session:" tmux >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  set {appName, sessionTag, fallback} to argv
  tell application "System Events"
    if not (exists process appName) then return
    tell process appName
      -- Address every element by index. System Events hands back element
      -- references keyed by *name*, and selecting a tab renames the window it
      -- lives in, so anything captured up front goes stale mid-loop.
      set winCount to count of windows
      -- Pass 1 looks for the session tag, pass 2 settles for the command name.
      repeat with pass from 1 to 2
        repeat with w from 1 to winCount
          if exists tab group 1 of window w then
            repeat with t from 1 to (count of radio buttons of tab group 1 of window w)
              if my matches(title of radio button t of tab group 1 of window w, ¬
                  sessionTag, fallback, pass) then
                if value of radio button t of tab group 1 of window w is false then
                  click radio button t of tab group 1 of window w
                end if
                perform action "AXRaise" of window w
                return
              end if
            end repeat
          else if my matches(title of window w, sessionTag, fallback, pass) then
            perform action "AXRaise" of window w
            return
          end if
        end repeat
      end repeat
    end tell
  end tell
end run

-- `contains`, not `starts with`: Ghostty prefixes a tab that rang the bell with
-- a 🔔, and tmux's set-titles-string can lead with alert markers of its own.
on matches(t, sessionTag, fallback, pass)
  if t is missing value then return false
  if pass is 1 then return t contains sessionTag
  return t contains fallback
end matches
APPLESCRIPT

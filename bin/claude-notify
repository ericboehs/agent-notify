#!/bin/bash
# claude-notify - Notification handler for Claude Code hooks

# Hooks inherit Claude's PATH, but --recv runs as an ssh forced command, which
# gets a bare one — no ~/bin (slack-noti) and no Homebrew (jq, tmux).
export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Enable/disable Slack notifications (defaults to true)
# CLAUDE_NOTIFY_SLACK=false        - never send Slack notifications
# CLAUDE_NOTIFY_SLACK_SLEEP_ONLY=true - only send when display is asleep (AFK)
# CLAUDE_NOTIFY_HOST=gfe            - prefix the session label (e.g. "gfe:hd-recovery")
#                                    to distinguish this machine from others sharing the
#                                    same #notifications channel. Unset = no prefix.
# CLAUDE_NOTIFY_FORWARD=e14,e14-wifi - this machine has no GUI worth notifying (a box you
#                                    only ever ssh into), so hand the notification to the
#                                    machine you are sitting at and let its claude-notify
#                                    --recv draw it. Comma-separated addresses for the
#                                    same host are tried in order, since DHCP decides
#                                    which one answers today.
#
# --recv                            - read one of those forwarded payloads on stdin instead
#                                    of a hook payload. Wired up as a forced command in
#                                    ~/.ssh/authorized_keys so the sending box's key can do
#                                    this and nothing else.
CLAUDE_NOTIFY_SLACK="${CLAUDE_NOTIFY_SLACK:-true}"
CLAUDE_NOTIFY_SLACK_SLEEP_ONLY="${CLAUDE_NOTIFY_SLACK_SLEEP_ONLY:-false}"
# Terminal app to raise when a desktop notification is clicked
CLAUDE_NOTIFY_TERMINAL="${CLAUDE_NOTIFY_TERMINAL:-Ghostty}"
# Thumbnail drawn on the right of the banner. The banner icon says which terminal
# (Ghostty), so this says which *kind* of prompt: Claude's glyph by default, a
# question mark for AskUserQuestion, 1Password's when claude-1p-notify overrides
# it. .icns is accepted as-is.
#
# Whether the caller picked one has to be recorded before defaulting, so the
# per-event overrides further down can tell "unset" from "deliberately chosen"
# and leave claude-1p-notify's 1Password icon alone. The `-` (not `:-`) default
# then means CLAUDE_NOTIFY_IMAGE= drops the thumbnail entirely, and a missing
# file is skipped at send time rather than erroring.
CLAUDE_NOTIFY_IMAGE_SET="${CLAUDE_NOTIFY_IMAGE+1}"
CLAUDE_NOTIFY_IMAGE="${CLAUDE_NOTIFY_IMAGE-/Applications/Claude.app/Contents/Resources/electron.icns}"

# Resolve tmux-focus alongside this script; the notification click action runs
# with a bare PATH, and this file is normally reached through a ~/bin symlink.
TMUX_FOCUS=$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/tmux-focus

# macOS draws the banner's icon and name from the bundle that posted it, so
# posting through our own copy of terminal-notifier.app (built by
# claude-notify-app, carrying the terminal's icon) is what turns the generic
# Terminal icon into Ghostty's. Fall back to the plain CLI if it isn't built.
NOTIFIER_APP="$HOME/Applications/${CLAUDE_NOTIFY_APP_NAME:-Claude Code} Notify.app"
NOTIFIER="$NOTIFIER_APP/Contents/MacOS/terminal-notifier"
[[ -x "$NOTIFIER" ]] || NOTIFIER="terminal-notifier"

# Deduplication: skip if same message sent within this many seconds
DEDUPE_WINDOW=30
DEDUPE_FILE="$HOME/.claude/manager/notify-last"

# Parse command line arguments
sender=""
recv=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --sender)
            sender="$2"
            shift 2
            ;;
        --recv)
            recv=1
            shift
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# Read JSON from stdin
json=$(cat)

# Locate this hook's entry in ~/.claude/sessions/, where Claude keeps one file
# per live session holding its name, sessionId and pid. Empty if not found.
claude_session_file() {
    local sid="$1" dir="$HOME/.claude/sessions" file pid

    # Hooks Claude invokes directly get .session_id on stdin.
    if [[ -n "$sid" ]]; then
        file=$(jq -r --arg sid "$sid" 'select(.sessionId == $sid) | input_filename' \
            "$dir"/*.json 2>/dev/null | head -1)
        [[ -n "$file" ]] && { echo "$file"; return; }
    fi

    # Wrappers (claude-manager-hook.sh, claude-1p-notify) synthesise their own
    # {title,message} payload and drop session_id, so walk up the process tree
    # instead: the hook is always a descendant of the claude process the file is
    # named for.
    pid=$$
    while [[ -n "$pid" && "$pid" -gt 1 ]]; do
        [[ -f "$dir/$pid.json" ]] && { echo "$dir/$pid.json"; return; }
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d "[:space:]")
    done
}

# The AI-generated title Claude writes into the transcript ("Diagnose 16TB
# Seagate drive failure") — what /list-agents shows for a session you never
# named. Re-derived as the conversation moves on, so take the last one.
claude_ai_title() {
    local sid="$1" transcript titles

    for transcript in "$HOME/.claude/projects"/*/"$sid.jsonl"; do
        [[ -f "$transcript" ]] || continue
        # These land every few turns, so the tail almost always has one; only
        # walk a multi-megabyte transcript end to end when it doesn't.
        titles=$(tail -c 262144 "$transcript" | grep -a '"type":"ai-title"')
        [[ -z "$titles" ]] && titles=$(grep -a '"type":"ai-title"' "$transcript")
        printf '%s\n' "$titles" | tail -1 | jq -r '.aiTitle // empty' 2>/dev/null
        return
    done
}

# The pane on the *other* machine — the one running the ssh client this session
# is reached through, and so the one a notification from here should focus. Empty
# when nobody is connected, which just means the banner gets no click action.
#
# LC_CLAUDE_PANE arrives through ssh's default `SendEnv LANG LC_*` / sshd's
# matching AcceptEnv, so no sshd configuration is involved. Claude has it in its
# own environment when it runs in the ssh session directly; inside a tmux over
# here it does not, because the tmux session outlives any one ssh connection —
# hence the file the login shell drops per tty, read through whichever client is
# attached right now.
origin_pane() {
    local session tty origin

    # Inside a tmux here, the attached client is the only current answer: the
    # session outlives connections, so the LC_CLAUDE_PANE its panes inherited
    # names whichever pane happened to start the server, possibly days ago.
    if [[ -n "${TMUX_PANE:-}" ]]; then
        session=$(tmux display-message -t "$TMUX_PANE" -p '#{session_name}' 2>/dev/null)
        tty=$(tmux list-clients -t "$session" -F '#{client_activity}|#{client_tty}' 2>/dev/null |
            sort -rn | head -1 | cut -d'|' -f2)
        [[ -n "$tty" ]] && origin=$(cat "$HOME/.claude/origin/${tty//\//-}" 2>/dev/null)
    fi

    # Straight into the ssh session with no tmux, and the environment is right.
    echo "${origin:-${LC_CLAUDE_PANE:-}}"
}

# Get tmux info if available. Anchor to $TMUX_PANE — the pane THIS Claude process
# runs in (inherited by the hook) — not the active/focused pane. Without -t,
# display-message reports whichever pane is focused, so a notification from an
# unfocused pane would be mis-tagged (e.g. code:2.0 posted as code:1.0).
if [[ -n "$TMUX_PANE" ]]; then
    tmux_info=$(tmux display-message -t "$TMUX_PANE" -p '#S:#{window_index}.#{pane_index}')
elif [[ -n "$TMUX" ]]; then
    tmux_info=$(tmux display-message -p '#S:#{window_index}.#{pane_index}')
else
    tmux_info="Session"
fi

# Keep the raw tmux target for the notification click action, separate from
# whatever the banner ends up calling this pane. Empty means "not in tmux", so
# there is nothing to click through to.
tmux_target=""
[[ "$tmux_info" != "Session" ]] && tmux_target="$tmux_info"

# What the notification calls this session, best name first: the one you gave it
# ("hd-recovery"), else the title Claude inferred, else the tmux coordinates —
# which only mean something once the layout is memorised. Clicking through lands
# on the same pane whichever it is.
session_file=""
[[ -z "$recv" ]] && session_file=$(claude_session_file "$(echo "$json" | jq -r '.session_id // empty')")
if [[ -n "$session_file" ]]; then
    label=$(jq -r '.name // empty' "$session_file" 2>/dev/null)
    [[ -z "$label" ]] && label=$(claude_ai_title "$(jq -r '.sessionId // empty' "$session_file" 2>/dev/null)")
fi
label="${label:-$tmux_info}"

# Optional per-machine prefix so notifications from different hosts are
# distinguishable in a shared #notifications channel (e.g. "gfe:hd-recovery").
# Baked into the label so the desktop message and dedup hash agree with it.
if [[ -n "$CLAUDE_NOTIFY_HOST" ]]; then
    label="${CLAUDE_NOTIFY_HOST}:${label}"
fi

# Every Slack post from this pane carries the same header, so its thread stays
# the pane's thread even as the label follows a rename.
header=":claude: $label"

# Where a click goes after it has focused $tmux_target, as HOST:SESSION:WINDOW.PANE.
# Only --recv sets it: a forwarded notification's local target is the pane holding
# the ssh, and this is the pane holding Claude on the far end of it.
remote_focus=""
# Repeat notifications replace rather than stack, keyed by pane. Forwarded ones
# key on the sending machine's pane instead, since several of its sessions can
# share one ssh — and so one local pane.
notify_group=""

# Forward mode: hand the whole notification to the machine the person is sitting
# at. Everything the banner needs is settled here, on the machine that knows it;
# the far end only draws it and works out which of *its* panes to focus.
forward_notification() {
    local payload host

    payload=$(jq -n \
        --arg label "$label" \
        --arg subtitle "$1" \
        --arg message "$2" \
        --arg slack_body "$3" \
        --arg origin "$(origin_pane)" \
        --arg host "${CLAUDE_NOTIFY_HOST:-$(hostname -s)}" \
        --arg target "$tmux_target" \
        '{label: $label, subtitle: $subtitle, message: $message,
          slack_body: $slack_body, origin: $origin, host: $host, target: $target}')

    for host in ${CLAUDE_NOTIFY_FORWARD//,/ }; do
        # The requested command is what runs if the key is unrestricted; the
        # authorized_keys forced command overrides it with the same thing.
        printf '%s' "$payload" |
            ssh -o BatchMode=yes -o ConnectTimeout=4 "$host" 'bin/claude-notify --recv' \
                >/dev/null 2>&1 && return 0
    done
    return 1
}

# Check for duplicate Slack messages
is_duplicate_slack() {
    local msg="$1"
    local msg_hash=$(echo -n "$label:$msg" | md5 -q)
    local now=$(date +%s)

    mkdir -p "$(dirname "$DEDUPE_FILE")"

    if [[ -f "$DEDUPE_FILE" ]]; then
        local last_hash=$(head -1 "$DEDUPE_FILE")
        local last_time=$(tail -1 "$DEDUPE_FILE")

        if [[ "$msg_hash" == "$last_hash" ]] && [[ $((now - last_time)) -lt $DEDUPE_WINDOW ]]; then
            return 0  # is duplicate
        fi
    fi

    # Save this message
    echo "$msg_hash" > "$DEDUPE_FILE"
    echo "$now" >> "$DEDUPE_FILE"
    return 1  # not duplicate
}

# Check if the display is asleep (Apple Silicon compatible)
is_display_asleep() {
    python3 -c "
import ctypes, ctypes.util
cg = ctypes.cdll.LoadLibrary(ctypes.util.find_library('CoreGraphics'))
cg.CGMainDisplayID.restype = ctypes.c_uint32
cg.CGDisplayIsAsleep.restype = ctypes.c_int
cg.CGDisplayIsAsleep.argtypes = [ctypes.c_uint32]
exit(0 if cg.CGDisplayIsAsleep(cg.CGMainDisplayID()) else 1)
" 2>/dev/null
}

# slack-noti wants the webhook in its environment, and --recv has no environment
# to speak of: an ssh forced command reaches neither the GUI session's launchd
# variables nor the login keychain fnox keeps them in. Copying the secret to disk
# — or onto coop — to fix that is far more than a notification is worth. The tmux
# server does have it, having been started from a login shell in the GUI session,
# so hand it the post and let it supply the environment.
slack_post() {
    local msg="$1"

    if [[ -n "${BOEHS_SLACK_NOTI_HOOK:-}" ]]; then
        slack-noti "$msg"
    elif command -v tmux >/dev/null 2>&1 && tmux has-session 2>/dev/null; then
        # -b so a slow webhook never holds up the hook that is waiting on us.
        tmux run-shell -b "$(printf '%q %q' "$HOME/bin/slack-noti" "$msg")"
    fi
}

# Send notification. The session label is the banner *title* — the one line
# macOS always shows in full and never truncates — so a glance at a stack of
# banners says which session each came from. What happened goes in the subtitle
# ("Claude Code Stopped"), and the detail in the message.
send_notification() {
    local subtitle="$1"
    local message="$2"
    local slack_header="${3:-$header}"
    local slack_body="${4:-$message}"

    # Nothing local to draw on, and Slack is the far end's call too — it knows
    # whether the display over there is asleep.
    if [[ -n "${CLAUDE_NOTIFY_FORWARD:-}" ]]; then
        forward_notification "$subtitle" "$message" "$slack_body"
        return
    fi

    # Clicking a banner should land on the pane that sent it. -execute runs on
    # click (the default is to do nothing at all), and -group makes a repeat
    # notification from the same pane replace the previous one rather than
    # stacking up in Notification Center.
    local -a notifier_args=(-title "$label" -message "$message")
    # claude-manager-hook.sh has no event name to give beyond a placeholder
    # "Claude"; drop that rather than spend the subtitle line saying nothing.
    [[ -n "$subtitle" && "$subtitle" != "Claude" ]] && notifier_args+=(-subtitle "$subtitle")
    [[ -f "$CLAUDE_NOTIFY_IMAGE" ]] && notifier_args+=(-contentImage "$CLAUDE_NOTIFY_IMAGE")
    if [[ -n "$tmux_target" ]]; then
        notifier_args+=(
            -execute "$(printf '%q %q %q %q' "$TMUX_FOCUS" "$tmux_target" \
                "$CLAUDE_NOTIFY_TERMINAL" "$remote_focus")"
            -group "${notify_group:-claude-$tmux_target}"
        )
    fi

    # Only check if iTerm2 is frontmost when --sender com.googlecode.iterm2 is passed
    if [[ "$sender" == "com.googlecode.iterm2" ]]; then
        local frontmost_app=$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true')
        if [[ "$frontmost_app" != "iTerm2" ]]; then
            "$NOTIFIER" "${notifier_args[@]}"
        fi
    else
        "$NOTIFIER" "${notifier_args[@]}"
    fi

    # Send Slack notification if enabled (with deduplication)
    # CLAUDE_NOTIFY_SLACK=false disables all Slack notifications
    # CLAUDE_NOTIFY_SLACK_SLEEP_ONLY=true only sends when display is asleep
    if [[ "$CLAUDE_NOTIFY_SLACK" == "true" ]]; then
        local should_send=true
        if [[ "$CLAUDE_NOTIFY_SLACK_SLEEP_ONLY" == "true" ]]; then
            if ! is_display_asleep; then
                should_send=false
            fi
        fi
        if [[ "$should_send" == "true" ]]; then
            local full_msg="$slack_header"$'\n\n'"$slack_body"
            if ! is_duplicate_slack "$full_msg"; then
                slack_post "$full_msg"
            fi
        fi
    fi
}

# --recv: a notification forwarded from another machine's claude-notify. Its
# label, event and body are settled; what is left is the click target, and that
# is two panes deep — the local one holding the ssh session, then the pane on the
# far side running Claude.
if [[ -n "$recv" ]]; then
    label=$(echo "$json" | jq -r '.label // "Remote"')
    header=":claude: $label"
    tmux_target=$(echo "$json" | jq -r '.origin // empty')
    remote_focus=$(echo "$json" | jq -r 'if (.host // "") != "" and (.target // "") != ""
                                         then "\(.host):\(.target)" else "" end')
    notify_group="claude-$(echo "$json" | jq -r '(.host // "remote") + "-" + (.target // "")')"
    send_notification \
        "$(echo "$json" | jq -r '.subtitle // empty')" \
        "$(echo "$json" | jq -r '.message // empty')" \
        "$header" \
        "$(echo "$json" | jq -r '.slack_body // .message // empty')"
    exit 0
fi

# AskUserQuestion (PreToolUse hook): Claude is waiting on the user to choose.
# Post the actual question(s) and numbered options, so the Slack message says what
# is being asked and can be answered from the Claude app without walking back.
if [[ "$(echo "$json" | jq -r '.tool_name // empty')" == "AskUserQuestion" ]]; then
    body=$(echo "$json" | jq -r '
        .tool_input.questions[]? as $q
        | "*\($q.header // "Question")*\(if $q.multiSelect then " (choose any)" else "" end): \($q.question)"
          + ( [ $q.options | to_entries[]
                | "\n  \(.key + 1). \(.value.label)"
                  + (if (.value.description // "") != "" then " — \(.value.description)" else "" end)
              ] | join("") )
    ' 2>/dev/null)
    [[ -z "$body" ]] && body="Claude is asking for your input."
    # Slack gets every question and option; the banner gets the first question,
    # stripped of the *bold* markers Slack wants.
    desktop_body=$(printf '%s\n' "$body" | head -1 | tr -d '*')
    [[ -z "$desktop_body" ]] && desktop_body="Claude is asking for your input."
    # This one is blocked on an answer, not just finished — a question mark
    # separates it from a Stop banner without having to read the text. Only
    # overrides the default, so an explicit CLAUDE_NOTIFY_IMAGE still wins.
    question_icon="$NOTIFIER_APP/Contents/Resources/question.png"
    [[ -z "${CLAUDE_NOTIFY_IMAGE_SET:-}" && -f "$question_icon" ]] && CLAUDE_NOTIFY_IMAGE="$question_icon"
    send_notification "Waiting on your answer" "$desktop_body" "$header" "$body"
    exit 0
fi

# Notification event (a permission/approval prompt, or an idle "waiting for your
# input" nudge). Claude Code fires this with a ready-made human-readable .message
# but no .title — handle it before the title+message check so it doesn't fall
# through to the generic Stop path.
if [[ "$(echo "$json" | jq -r '.hook_event_name // empty')" == "Notification" ]]; then
    body=$(echo "$json" | jq -r '.message // "Claude needs your attention."')
    # Skip the idle "waiting for your input" nudge: it fires ~60s after the agent
    # stops (already covered by the Stop hook) and is just noise. Only surface
    # actionable notifications like permission/approval prompts.
    lc=$(echo "$body" | tr '[:upper:]' '[:lower:]')
    case "$lc" in
        *"waiting for your input"*) exit 0 ;;
    esac
    send_notification "Claude needs your attention" "$body" "$header" "$body"
    exit 0
fi

# Check if this is a notification with title/message or a stop hook
if echo "$json" | jq -e '.title and .message' >/dev/null 2>&1; then
    # Notification payload
    title=$(echo "$json" | jq -r '.title')
    body=$(echo "$json" | jq -r '.message')
    send_notification "$title" "$body" "$header" "$body"
else
    # Stop hook payload
    body="Ready for further instruction."
    send_notification "Claude Code Stopped" "Ready for further instruction." "$header" "$body"
fi

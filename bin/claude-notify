#!/bin/bash
# claude-notify - Notification handler for Claude Code hooks

# Enable/disable Slack notifications (defaults to true)
CLAUDE_NOTIFY_SLACK="${CLAUDE_NOTIFY_SLACK:-true}"

# Deduplication: skip if same message sent within this many seconds
DEDUPE_WINDOW=30
DEDUPE_FILE="$HOME/.claude/manager/notify-last"

# Parse command line arguments
sender=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --sender)
            sender="$2"
            shift 2
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# Read JSON from stdin
json=$(cat)

# Get tmux info if available
if [[ -n "$TMUX" ]]; then
    tmux_info=$(tmux display-message -p '#S:#{window_index}.#{pane_index}')
else
    tmux_info="Session"
fi

# Check for duplicate Slack messages
is_duplicate_slack() {
    local msg="$1"
    local msg_hash=$(echo -n "$tmux_info:$msg" | md5 -q)
    local now=$(date +%s)

    mkdir -p "$(dirname "$DEDUPE_FILE")"

    if [[ -f "$DEDUPE_FILE" ]]; then
        local last_hash=$(head -1 "$DEDUPE_FILE")
        local last_time=$(tail -1 "$DEDUPE_FILE")

        if [[ "$msg_hash" == "$last_hash" ]] && [[ $((now - last_time)) -lt $DEDUPE_WINDOW ]]; then
            return 0  # is duplicate
        fi
    fi

    # Save this message
    echo "$msg_hash" > "$DEDUPE_FILE"
    echo "$now" >> "$DEDUPE_FILE"
    return 1  # not duplicate
}

# Send notification
send_notification() {
    local title="$1"
    local message="$2"
    local slack_header="${3:-$title}"
    local slack_body="${4:-$message}"

    # Only check if iTerm2 is frontmost when --sender com.googlecode.iterm2 is passed
    if [[ "$sender" == "com.googlecode.iterm2" ]]; then
        local frontmost_app=$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true')
        if [[ "$frontmost_app" != "iTerm2" ]]; then
            terminal-notifier -title "$title" -message "$message"
        fi
    else
        terminal-notifier -title "$title" -message "$message"
    fi

    # Send Slack notification if enabled (with deduplication)
    if [[ "$CLAUDE_NOTIFY_SLACK" == "true" ]]; then
        local full_msg="$slack_header"$'\n\n'"$slack_body"
        if ! is_duplicate_slack "$full_msg"; then
            slack-noti "$full_msg"
        fi
    fi
}

# Check if this is a notification with title/message or a stop hook
if echo "$json" | jq -e '.title and .message' >/dev/null 2>&1; then
    # Notification payload
    title=$(echo "$json" | jq -r '.title')
    body=$(echo "$json" | jq -r '.message')
    header=":claude: $tmux_info"
    send_notification "$title" "$tmux_info: $body" "$header" "$body"
else
    # Stop hook payload
    header=":claude: $tmux_info"
    body="Ready for further instruction."
    send_notification "Claude Code Stopped" "$tmux_info is ready for further instruction." "$header" "$body"
fi
